{
  "manifest_version": 3,
  "name": "PhishEye — Real-time Fake Login Detector",
  "version": "1.0",
  "description": "Detects suspicious login pages using heuristic checks: favicon mismatch, HTTPS, form target mismatch, suspicious keywords.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishEye"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ]
}
